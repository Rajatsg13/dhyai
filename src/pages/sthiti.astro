---
import Base from '../layouts/Base.astro';
---
<Base
  title="Sthiti — Collection I · Dhyai"
  description="Sthiti — to be settled, completely. The first Dhyai collection. Block-printed textiles in bedsheets, dohars, bedcovers, and table linen."
  ogImage="/assets/images/sthiti_cover.jpg"
  ogUrl="/sthiti.html"
  currentPage="sthiti"
>

  <!-- ══ Collection hero ══ -->
  <div class="col-hero">
    <div class="hero-media">
      <img
        src="/assets/images/sthiti_cover.jpg"
        alt="Sthiti — Collection I by Dhyai"
        loading="eager"
        fetchpriority="high"
        style="width:100%;height:100%;object-fit:cover"
      >
    </div>
    <div class="col-hero-overlay"></div>
    <div class="col-hero-content">
      <span class="kicker">Collection · I</span>
      <h1>Sthiti</h1>
      <span class="dev">स्थिति</span>
    </div>
  </div>

  <!-- ══ Collection description ══ -->
  <section class="section reveal" style="max-width:700px">
    <p style="margin-bottom:1.2rem; font-size:1.05rem">
      — to be settled, completely. The first collection. A design where colour and form
      have stopped moving against each other and simply arrived. A grid that holds its ground.
      A floral medallion that punctuates, not decorates.
    </p>
    <p>
      The bedroom. The dining table. The room you return to without thinking.
    </p>
  </section>

  <!-- ══ Surface study ══ -->
  <section class="section" style="padding-top:0; border-top:1px solid rgba(237,227,204,.05)">
    <div class="two-col reveal">
      <div class="two-col-img">
        <img src="/assets/images/sthiti_surface_full.jpg" alt="Sthiti surface — full view" loading="lazy">
      </div>
      <div class="two-col-text">
        <span class="kicker">The pattern</span>
        <div class="rule-h"></div>
        <h2>A grid that holds its ground</h2>
        <p>
          Sthiti is built around a repeating structure — a grid that gives the cloth
          its backbone, and a floral medallion that arrives at measured intervals.
        </p>
        <p>
          Cotton is selected for surface clarity. Block-printed by hand in the studio.
          Each piece made to the dimensions you specify.
        </p>
      </div>
    </div>
  </section>

  <!-- ══ Products ══ -->
  <section class="section" style="border-top:1px solid rgba(237,227,204,.05)">
    <span class="kicker reveal" style="margin-bottom:3rem">Available formats</span>

    <div class="products-grid">

      <!-- Bedsheet -->
      <div class="reveal">
        <div class="product-carousel">
          <div class="carousel-track">
            <img src="/assets/images/sthiti_bs_1.webp" alt="Sthiti Bedsheet" loading="lazy">
            <img src="/assets/images/sthiti_bs_2.webp" alt="Sthiti Bedsheet — detail" loading="lazy">
            <img src="/assets/images/sthiti_bs_3.webp" alt="Sthiti Bedsheet — fold" loading="lazy">
          </div>
          <div class="carousel-dots">
            <span class="carousel-dot on"></span>
            <span class="carousel-dot"></span>
            <span class="carousel-dot"></span>
          </div>
        </div>
        <p class="prod-collection">Sthiti</p>
        <p class="prod-name">Bedsheet</p>
        <p class="prod-specs">King 108×108″ · Queen 90×108″</p>
        <p class="prod-mto">Made to order · Delivered worldwide</p>
        <a href="/contact.html" class="btn-enquire">Enquire</a>
      </div>

      <!-- Dohar -->
      <div class="reveal d1">
        <div class="product-carousel">
          <div class="carousel-track">
            <img src="/assets/images/sthiti_dohar_1.webp" alt="Sthiti Dohar" loading="lazy">
            <img src="/assets/images/sthiti_dohar_2.webp" alt="Sthiti Dohar — detail" loading="lazy">
            <img src="/assets/images/sthiti_dohar_3.webp" alt="Sthiti Dohar — fold" loading="lazy">
          </div>
          <div class="carousel-dots">
            <span class="carousel-dot on"></span>
            <span class="carousel-dot"></span>
            <span class="carousel-dot"></span>
          </div>
        </div>
        <p class="prod-collection">Sthiti</p>
        <p class="prod-name">Dohar</p>
        <p class="prod-specs">Pure mulmul · 90×108″</p>
        <p class="prod-mto">Made to order · Delivered worldwide</p>
        <a href="/contact.html" class="btn-enquire">Enquire</a>
      </div>

      <!-- Bedcover -->
      <div class="reveal">
        <div class="product-carousel">
          <div class="carousel-track">
            <img src="/assets/images/sthiti_bc_1.webp" alt="Sthiti Bedcover" loading="lazy">
            <img src="/assets/images/sthiti_bc_2.webp" alt="Sthiti Bedcover — detail" loading="lazy">
            <img src="/assets/images/sthiti_bc_3.webp" alt="Sthiti Bedcover — fold" loading="lazy">
          </div>
          <div class="carousel-dots">
            <span class="carousel-dot on"></span>
            <span class="carousel-dot"></span>
            <span class="carousel-dot"></span>
          </div>
        </div>
        <p class="prod-collection">Sthiti</p>
        <p class="prod-name">Bedcover</p>
        <p class="prod-specs">Slub cotton · 90×108″</p>
        <p class="prod-mto">Made to order · Delivered worldwide</p>
        <a href="/contact.html" class="btn-enquire">Enquire</a>
      </div>

      <!-- Table Cover -->
      <div class="reveal d1">
        <div class="product-carousel">
          <div class="carousel-track">
            <img src="/assets/images/sthiti_tc.webp" alt="Sthiti Table Cover" loading="lazy">
          </div>
        </div>
        <p class="prod-collection">Sthiti</p>
        <p class="prod-name">Table Cover</p>
        <p class="prod-specs">Cotton · Custom dimensions available</p>
        <p class="prod-mto">Made to order</p>
        <a href="/contact.html" class="btn-enquire">Enquire</a>
      </div>

    </div>
  </section>

  <!-- ══ Format reference ══ -->
  <section class="section" style="border-top:1px solid rgba(237,227,204,.05)">
    <span class="kicker reveal" style="margin-bottom:2.5rem">Format reference</span>
    <div class="products-grid reveal">
      <div>
        <img src="/assets/images/sthiti_format_bedsheet.jpg" alt="Sthiti bedsheet format" loading="lazy" style="width:100%;aspect-ratio:3/2;object-fit:cover;margin-bottom:1rem">
        <p class="prod-collection">Bedsheet</p>
      </div>
      <div>
        <img src="/assets/images/sthiti_format_dohar.jpg" alt="Sthiti dohar format" loading="lazy" style="width:100%;aspect-ratio:3/2;object-fit:cover;margin-bottom:1rem">
        <p class="prod-collection">Dohar</p>
      </div>
      <div>
        <img src="/assets/images/sthiti_format_bedcover.jpg" alt="Sthiti bedcover format" loading="lazy" style="width:100%;aspect-ratio:3/2;object-fit:cover;margin-bottom:1rem">
        <p class="prod-collection">Bedcover</p>
      </div>
      <div>
        <img src="/assets/images/sthiti_format_tablecover.jpg" alt="Sthiti table cover format" loading="lazy" style="width:100%;aspect-ratio:3/2;object-fit:cover;margin-bottom:1rem">
        <p class="prod-collection">Table cover</p>
      </div>
    </div>
  </section>

  <!-- ══ Related collections ══ -->
  <section class="section" style="border-top:1px solid rgba(237,227,204,.05)">
    <span class="kicker reveal" style="margin-bottom:2.5rem">Other collections</span>
    <div class="cols-grid" style="grid-template-columns:repeat(2,1fr)">
      <a class="col-card reveal" href="/sthna.html">
        <img src="/assets/images/sthna_cover.jpg" alt="Sthana — Collection II" loading="lazy">
        <div class="col-card-layer">
          <span class="kicker">Collection · II</span>
          <h3>Sthana</h3>
          <span class="dev">स्थान</span>
          <span class="col-arrow">View collection →</span>
        </div>
      </a>
      <a class="col-card reveal d1" href="/punar.html">
        <img src="/assets/images/punar_cover.jpg" alt="Punar — Collection III" loading="lazy">
        <div class="col-card-layer">
          <span class="kicker">Collection · III</span>
          <h3>Punar</h3>
          <span class="dev">पुनर्</span>
          <span class="col-arrow">View collection →</span>
        </div>
      </a>
    </div>
  </section>

</Base>
