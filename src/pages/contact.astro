---
import Base from '../layouts/Base.astro';

const error = Astro.url.searchParams.get('error');
const errorMessages: Record<string, string> = {
  missing: 'Please fill in all required fields.',
  email:   'Please enter a valid email address.',
  send:    'There was an issue sending your message. Please try again or write to us directly.',
};
---
<Base
  title="Enquire — Dhyai"
  description="Enquire about Dhyai studies — available as bed sheets, bedcovers, dohars, and table linen. Orders placed directly."
  ogImage="/assets/images/hero_jali_shadow.jpg"
  ogUrl="/contact.html"
  currentPage="contact"
>

  <section class="section" style="padding-top:calc(var(--section-y) + 4rem)">
    <div class="two-col" style="align-items:start; gap:clamp(3rem,8vw,12rem)">

      <!-- Left: info -->
      <div class="reveal">
        <span class="kicker" style="margin-bottom:1.2rem">Enquire</span>
        <div class="rule-h"></div>
        <h1 style="font-size:clamp(2.2rem,5vw,4rem); letter-spacing:.18em; margin-bottom:2rem">
          Let's talk
        </h1>
        <div class="contact-meta">
          <p style="margin-bottom:1.2rem; font-size:.95rem">
            All pieces are made to order. For enquiries about collections,
            custom dimensions, delivery, or the brass works — write to us.
          </p>
          <div style="margin-top:2rem">
            <a href="mailto:contact@dhyai.studio">contact@dhyai.studio</a>
            <a href="tel:+918368544393">+91 83685 44393</a>
          </div>
        </div>
        <div style="margin-top:3rem; padding-top:2rem; border-top:1px solid rgba(237,227,204,.06)">
          <p style="font-size:.85rem; margin-bottom:1rem; color:var(--faint)">
            Studio · Bengaluru, India
          </p>
          <p style="font-size:.85rem; color:var(--faint)">
            Instagram: <a href="https://www.instagram.com/dhyai.studio" target="_blank" rel="noopener" style="color:var(--dim); transition:color .3s" onmouseenter="this.style.color='var(--cream)'" onmouseleave="this.style.color='var(--dim)'">@dhyai.studio</a>
          </p>
        </div>
      </div>

      <!-- Right: form -->
      <div class="reveal d1">
        {error && (
          <div class="form-notice error">
            {errorMessages[error] ?? 'Something went wrong. Please try again.'}
          </div>
        )}

        <form action="/contact.php" method="POST" name="enquiries" novalidate>
          <input type="hidden" name="form-name" value="enquiries">
          <!-- Honeypot fields — must stay empty -->
          <div style="display:none" aria-hidden="true">
            <input name="bot-field" tabindex="-1" autocomplete="off">
            <input name="company" tabindex="-1" autocomplete="off">
          </div>

          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" required>
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required>
          </div>
          <div class="field">
            <label for="phone">Phone <span style="opacity:.45; font-size:.8em">(optional)</span></label>
            <input id="phone" name="phone" type="tel" autocomplete="tel">
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" required></textarea>
          </div>
          <button class="btn-send" type="submit">Send enquiry</button>
        </form>
      </div>

    </div>
  </section>

</Base>
