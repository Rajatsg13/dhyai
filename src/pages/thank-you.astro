---
import Base from '../layouts/Base.astro';
---
<Base
  title="Thank you — Dhyai"
  description="Your enquiry has been received."
>
  <div class="ty-page">
    <div>
      <span class="kicker" style="margin-bottom:1.5rem; display:block">Enquiry received</span>
      <div class="rule" style="margin-bottom:2.5rem"></div>
      <h1>Thank you</h1>
      <p style="margin-top:1.2rem; max-width:400px; margin-left:auto; margin-right:auto">
        We have received your enquiry and will respond within two working days.
      </p>
      <a href="/index.html" class="btn-enquire" style="margin-top:2.5rem; display:inline-block">
        Return to Dhyai
      </a>
    </div>
  </div>
</Base>
