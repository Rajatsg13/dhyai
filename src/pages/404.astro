---
import Base from '../layouts/Base.astro';
---
<Base
  title="Page not found — Dhyai"
  description="The page you were looking for was not found."
>
  <div class="not-found">
    <div style="position:relative; display:inline-block">
      <h1>404</h1>
      <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;white-space:nowrap">
        <p class="kicker" style="margin-bottom:1rem; display:block">Page not found</p>
        <p style="font-size:.9rem; margin-bottom:2rem; color:var(--faint)">
          The page you were looking for does not exist.
        </p>
        <a href="/index.html" class="btn-enquire">Return home</a>
      </div>
    </div>
  </div>
</Base>
