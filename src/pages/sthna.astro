---
import Base from '../layouts/Base.astro';
---
<Base
  title="Sthana — Collection II · Dhyai"
  description="Sthana — the place. The same vocabulary, now in a single family of colour. Five depths of green, from dark to almost nothing."
  ogImage="/assets/images/sthna_cover.jpg"
  ogUrl="/sthna.html"
  currentPage="sthna"
>

  <!-- ══ Collection hero ══ -->
  <div class="col-hero">
    <div class="hero-media">
      <img
        src="/assets/images/sthna_cover.jpg"
        alt="Sthana — Collection II by Dhyai"
        loading="eager"
        fetchpriority="high"
        style="width:100%;height:100%;object-fit:cover"
      >
    </div>
    <div class="col-hero-overlay"></div>
    <div class="col-hero-content">
      <span class="kicker">Collection · II</span>
      <h1>Sthana</h1>
      <span class="dev">स्थान</span>
    </div>
  </div>

  <!-- ══ Collection description ══ -->
  <section class="section reveal" style="max-width:700px">
    <p style="margin-bottom:1.2rem; font-size:1.05rem">
      — the place. The same vocabulary, now in a single family of colour.
      Five depths of green, from dark to almost nothing.
      Where Sthiti speaks, Sthana simply occupies.
    </p>
    <p>
      For rooms where the cloth should feel like it was always there.
    </p>
  </section>

  <!-- ══ Surface study ══ -->
  <section class="section" style="padding-top:0; border-top:1px solid rgba(237,227,204,.05)">
    <div class="two-col reveal">
      <div class="two-col-img">
        <img src="/assets/images/sthna_surface_full.jpg" alt="Sthana surface — full view" loading="lazy">
      </div>
      <div class="two-col-text">
        <span class="kicker">The palette</span>
        <div class="rule-h"></div>
        <h2>A single family of colour</h2>
        <p>
          Sthana uses the same structural grammar as Sthiti — the grid, the repeat,
          the measured medallion — but strips it to a monochrome. Five depths of green.
        </p>
        <p>
          The quieter a cloth, the longer it stays. Sthana is designed to settle,
          not to be noticed.
        </p>
      </div>
    </div>
  </section>

  <!-- ══ Products ══ -->
  <section class="section" style="border-top:1px solid rgba(237,227,204,.05)">
    <span class="kicker reveal" style="margin-bottom:3rem">Available formats</span>

    <div class="products-grid">

      <!-- Dohar -->
      <div class="reveal">
        <div class="product-carousel">
          <div class="carousel-track">
            <img src="/assets/images/sthana_dohar_1.webp" alt="Sthana Dohar" loading="lazy">
            <img src="/assets/images/sthana_dohar_2.webp" alt="Sthana Dohar — detail" loading="lazy">
          </div>
          <div class="carousel-dots">
            <span class="carousel-dot on"></span>
            <span class="carousel-dot"></span>
          </div>
        </div>
        <p class="prod-collection">Sthana</p>
        <p class="prod-name">Dohar</p>
        <p class="prod-specs">Pure mulmul · 90×108″</p>
        <p class="prod-mto">Made to order · Delivered worldwide</p>
        <a href="/contact.html" class="btn-enquire">Enquire</a>
      </div>

      <!-- Bedcover -->
      <div class="reveal d1">
        <div class="product-carousel">
          <div class="carousel-track">
            <img src="/assets/images/sthana_bc.webp" alt="Sthana Bedcover" loading="lazy">
          </div>
        </div>
        <p class="prod-collection">Sthana</p>
        <p class="prod-name">Bedcover</p>
        <p class="prod-specs">Slub cotton · 90×108″</p>
        <p class="prod-mto">Made to order</p>
        <a href="/contact.html" class="btn-enquire">Enquire</a>
      </div>

      <!-- Table Linen -->
      <div class="reveal">
        <div class="product-carousel">
          <div class="carousel-track">
            <img src="/assets/images/sthana_tl.webp" alt="Sthana Table Linen" loading="lazy">
          </div>
        </div>
        <p class="prod-collection">Sthana</p>
        <p class="prod-name">Table Linen</p>
        <p class="prod-specs">Runner · Placemats · Napkins</p>
        <p class="prod-mto">Made to order</p>
        <a href="/contact.html" class="btn-enquire">Enquire</a>
      </div>

    </div>
  </section>

  <!-- ══ Format reference ══ -->
  <section class="section" style="border-top:1px solid rgba(237,227,204,.05)">
    <span class="kicker reveal" style="margin-bottom:2.5rem">Format reference</span>
    <div class="products-grid reveal">
      <div>
        <img src="/assets/images/sthna_format_bedsheet.jpg" alt="Sthana bedsheet format" loading="lazy" style="width:100%;aspect-ratio:3/2;object-fit:cover;margin-bottom:1rem">
        <p class="prod-collection">Bedsheet</p>
      </div>
      <div>
        <img src="/assets/images/sthna_format_dohar.jpg" alt="Sthana dohar format" loading="lazy" style="width:100%;aspect-ratio:3/2;object-fit:cover;margin-bottom:1rem">
        <p class="prod-collection">Dohar</p>
      </div>
      <div>
        <img src="/assets/images/sthna_format_bedcover.jpg" alt="Sthana bedcover format" loading="lazy" style="width:100%;aspect-ratio:3/2;object-fit:cover;margin-bottom:1rem">
        <p class="prod-collection">Bedcover</p>
      </div>
      <div>
        <img src="/assets/images/sthna_format_tablelinen.jpg" alt="Sthana table linen format" loading="lazy" style="width:100%;aspect-ratio:3/2;object-fit:cover;margin-bottom:1rem">
        <p class="prod-collection">Table linen</p>
      </div>
    </div>
  </section>

  <!-- ══ Related collections ══ -->
  <section class="section" style="border-top:1px solid rgba(237,227,204,.05)">
    <span class="kicker reveal" style="margin-bottom:2.5rem">Other collections</span>
    <div class="cols-grid" style="grid-template-columns:repeat(2,1fr)">
      <a class="col-card reveal" href="/sthiti.html">
        <img src="/assets/images/sthiti_cover.jpg" alt="Sthiti — Collection I" loading="lazy">
        <div class="col-card-layer">
          <span class="kicker">Collection · I</span>
          <h3>Sthiti</h3>
          <span class="dev">स्थिति</span>
          <span class="col-arrow">View collection →</span>
        </div>
      </a>
      <a class="col-card reveal d1" href="/punar.html">
        <img src="/assets/images/punar_cover.jpg" alt="Punar — Collection III" loading="lazy">
        <div class="col-card-layer">
          <span class="kicker">Collection · III</span>
          <h3>Punar</h3>
          <span class="dev">पुनर्</span>
          <span class="col-arrow">View collection →</span>
        </div>
      </a>
    </div>
  </section>

</Base>
