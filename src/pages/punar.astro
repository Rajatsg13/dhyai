---
import Base from '../layouts/Base.astro';
---
<Base
  title="Punar — Collection III · Dhyai"
  description="Punar — once more. The vocabulary returns, lighter. A palm enters the composition, unhurried and particular. More air between the forms."
  ogImage="/assets/images/punar_cover.jpg"
  ogUrl="/punar.html"
  currentPage="punar"
>

  <!-- ══ Collection hero ══ -->
  <div class="col-hero">
    <div class="hero-media">
      <img
        src="/assets/images/punar_cover.jpg"
        alt="Punar — Collection III by Dhyai"
        loading="eager"
        fetchpriority="high"
        style="width:100%;height:100%;object-fit:cover"
      >
    </div>
    <div class="col-hero-overlay"></div>
    <div class="col-hero-content">
      <span class="kicker">Collection · III</span>
      <h1>Punar</h1>
      <span class="dev">पुनर्</span>
    </div>
  </div>

  <!-- ══ Collection description ══ -->
  <section class="section reveal" style="max-width:700px">
    <p style="margin-bottom:1.2rem; font-size:1.05rem">
      — once more. The vocabulary returns, lighter. A palm enters the composition —
      unhurried, particular. More air between the forms.
    </p>
    <p>
      Not a repeat. A reconsideration.
    </p>
  </section>

  <!-- ══ Surface study ══ -->
  <section class="section" style="padding-top:0; border-top:1px solid rgba(237,227,204,.05)">
    <div class="two-col reveal">
      <div class="two-col-img">
        <img src="/assets/images/punar_surface_full.jpg" alt="Punar surface — full view" loading="lazy">
      </div>
      <div class="two-col-text">
        <span class="kicker">The pattern</span>
        <div class="rule-h"></div>
        <h2>More air between the forms</h2>
        <p>
          Punar returns to familiar ground with a different pace.
          The palm motif brings something new without disrupting what came before.
        </p>
        <p>
          A reconsideration of the first two collections — quieter, with more space
          for the cloth to breathe. The same craft. A different feeling.
        </p>
      </div>
    </div>
  </section>

  <!-- ══ Products ══ -->
  <section class="section" style="border-top:1px solid rgba(237,227,204,.05)">
    <span class="kicker reveal" style="margin-bottom:3rem">Available formats</span>

    <div class="products-grid">

      <!-- Dohar -->
      <div class="reveal">
        <div class="product-carousel">
          <div class="carousel-track">
            <img src="/assets/images/punar_dohar.webp" alt="Punar Dohar" loading="lazy">
          </div>
        </div>
        <p class="prod-collection">Punar</p>
        <p class="prod-name">Dohar</p>
        <p class="prod-specs">Pure mulmul · 90×108″</p>
        <p class="prod-mto">Made to order · Delivered worldwide</p>
        <a href="/contact.html" class="btn-enquire">Enquire</a>
      </div>

      <!-- Bedsheet -->
      <div class="reveal d1">
        <div class="product-carousel">
          <div class="carousel-track">
            <img src="/assets/images/punar_bs.webp" alt="Punar Bedsheet" loading="lazy">
          </div>
        </div>
        <p class="prod-collection">Punar</p>
        <p class="prod-name">Bedsheet</p>
        <p class="prod-specs">King 108×108″ · Queen 90×108″</p>
        <p class="prod-mto">Made to order · Delivered worldwide</p>
        <a href="/contact.html" class="btn-enquire">Enquire</a>
      </div>

    </div>
  </section>

  <!-- ══ Format reference ══ -->
  <section class="section" style="border-top:1px solid rgba(237,227,204,.05)">
    <span class="kicker reveal" style="margin-bottom:2.5rem">Format reference</span>
    <div class="products-grid reveal">
      <div>
        <img src="/assets/images/punar_format_bedsheet.jpg" alt="Punar bedsheet format" loading="lazy" style="width:100%;aspect-ratio:3/2;object-fit:cover;margin-bottom:1rem">
        <p class="prod-collection">Bedsheet</p>
      </div>
      <div>
        <img src="/assets/images/punar_format_dohar.jpg" alt="Punar dohar format" loading="lazy" style="width:100%;aspect-ratio:3/2;object-fit:cover;margin-bottom:1rem">
        <p class="prod-collection">Dohar</p>
      </div>
      <div>
        <img src="/assets/images/punar_format_bedcover.jpg" alt="Punar bedcover format" loading="lazy" style="width:100%;aspect-ratio:3/2;object-fit:cover;margin-bottom:1rem">
        <p class="prod-collection">Bedcover</p>
      </div>
      <div>
        <img src="/assets/images/punar_format_tablelinen.jpg" alt="Punar table linen format" loading="lazy" style="width:100%;aspect-ratio:3/2;object-fit:cover;margin-bottom:1rem">
        <p class="prod-collection">Table linen</p>
      </div>
    </div>
  </section>

  <!-- ══ Preview ══ -->
  <section class="section" style="border-top:1px solid rgba(237,227,204,.05)">
    <div class="two-col reveal">
      <div class="two-col-img">
        <img src="/assets/images/punar_preview.jpg" alt="Punar — room view" loading="lazy">
      </div>
      <div class="two-col-text">
        <span class="kicker">In the room</span>
        <div class="rule-h"></div>
        <h2>A reconsideration</h2>
        <p>
          Punar is designed for rooms that already have a sensibility.
          It doesn't announce itself — it settles in.
        </p>
        <p>
          Custom dimensions available for all formats. Write to enquire.
        </p>
        <a href="/contact.html" class="btn-enquire">Enquire</a>
      </div>
    </div>
  </section>

  <!-- ══ Related collections ══ -->
  <section class="section" style="border-top:1px solid rgba(237,227,204,.05)">
    <span class="kicker reveal" style="margin-bottom:2.5rem">Other collections</span>
    <div class="cols-grid" style="grid-template-columns:repeat(2,1fr)">
      <a class="col-card reveal" href="/sthiti.html">
        <img src="/assets/images/sthiti_cover.jpg" alt="Sthiti — Collection I" loading="lazy">
        <div class="col-card-layer">
          <span class="kicker">Collection · I</span>
          <h3>Sthiti</h3>
          <span class="dev">स्थिति</span>
          <span class="col-arrow">View collection →</span>
        </div>
      </a>
      <a class="col-card reveal d1" href="/sthna.html">
        <img src="/assets/images/sthna_cover.jpg" alt="Sthana — Collection II" loading="lazy">
        <div class="col-card-layer">
          <span class="kicker">Collection · II</span>
          <h3>Sthana</h3>
          <span class="dev">स्थान</span>
          <span class="col-arrow">View collection →</span>
        </div>
      </a>
    </div>
  </section>

</Base>
